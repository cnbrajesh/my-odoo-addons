<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Blog Category Tree View -->
    <record id="view_blog_category_tree" model="ir.ui.view">
        <field name="name">blog.category.tree</field>
        <field name="model">blog.category</field>
        <field name="arch" type="xml">
            <tree string="Blog Categories">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slug"/>
            </tree>
        </field>
    </record>

    <!-- Blog Category Form View -->
    <record id="view_blog_category_form" model="ir.ui.view">
        <field name="name">blog.category.form</field>
        <field name="model">blog.category</field>
        <field name="arch" type="xml">
            <form string="Blog Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="slug"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Blog Category Action -->
    <record id="action_blog_category" model="ir.actions.act_window">
        <field name="name">Blog Categories</field>
        <field name="res_model">blog.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_blog_category_root"
              name="Blog Categories"
              parent="website_blog.menu_blog_global_settings"
              sequence="20"/>

    <menuitem id="menu_blog_category"
              name="Categories"
              parent="menu_blog_category_root"
              action="action_blog_category"
              sequence="10"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend blog.post form to add category_id -->
    <record id="view_blog_post_form_extended" model="ir.ui.view">
        <field name="name">blog.post.form.extended</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.blog_post_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='blog_id']" position="after">
                <field name="category_id"/>
            </xpath>
        </field>
    </record>

    <!-- Extend blog.post tree to add category_id -->
    <record id="view_blog_post_tree_extended" model="ir.ui.view">
        <field name="name">blog.post.tree.extended</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.blog_post_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='blog_id']" position="after">
                <field name="category_id"/>
            </xpath>
        </field>
    </record>
</odoo>
